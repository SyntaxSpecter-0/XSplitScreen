## Proprietary/third-party build dependencies - do NOT commit these.
# XSplitScreen/libs/ - DLLs (Facepunch.Steamworks, Rewired, Mono.Security, etc.) that
# XSplitScreen.csproj references via HintPath. They aren't redistributable; anyone building
# this mod needs to source their own copy of Risk of Rain 2 and copy the matching DLLs from
# "<RoR2 install>/Risk of Rain 2_Data/Managed/" into this folder themselves.
XSplitScreen/libs/

# XSplitScreen/r2api/ - R2API DLLs (Core, ContentManagement, Items, Language, Prefab) that
# XSplitScreen.csproj references via HintPath. Install R2API through r2modman/Thunderstore
# and copy the DLLs from its plugins folder here, or download them directly from Thunderstore.
XSplitScreen/r2api/

# Packaged build output for r2modman import - a build artifact, not source.
/XSplitScreen-import.zip

# One-off Editor scripts used to bootstrap the Unity project from the shipped asset bundle
# (extracting/dumping/checking the original prefabs and textures). Not part of the standing
# rebuild pipeline - only RebuildUserslotForRedesign.cs and BuildBundle.cs are.
UnityProject/Assets/Editor/ImportTools/

## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
